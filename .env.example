# Copy to .env and adjust. SQLite is the default so the app runs with zero setup.
DATABASE_URL=sqlite:///./eve.db
# DATABASE_URL=postgresql+psycopg2://eve:eve@localhost:5432/eve
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
WEBHOOK_SECRET=change-me-webhook-secret
# Comma separated. Users who sign up with these emails become admins (can manage centres/tests).
ADMIN_EMAILS=admin@example.com
# Probability that the mock payment endpoint returns SUCCESS
PAYMENT_SUCCESS_RATE=0.8
